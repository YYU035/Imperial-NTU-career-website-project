# Required for the visitor-record administrator page (?admin=1).
# Use a long, unique password and configure the same secret in production.
ADMIN_PASSWORD=replace-with-a-strong-password

# Required in production so registrations survive Streamlit app restarts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_secret

# Optional. Defaults to Data/visitor_registry.sqlite3.
# VISITOR_DB_PATH=/persistent/storage/visitor_registry.sqlite3
